FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 TZ=Asia/Seoul DATA_DIR=/tmp/rank-work PLAYWRIGHT_BROWSERS_PATH=/opt/browsers
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && python -m playwright install --with-deps chromium
COPY . .
RUN useradd --uid 10001 --create-home appuser && chmod -R a+rX /opt/browsers
USER appuser
EXPOSE 8000
CMD ["python", "start_production.py"]
